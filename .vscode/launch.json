{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Pico Debug launchjs",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/John-ADC-Git.elf",
            "servertype": "openocd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "searchDir": ["${env:PICO_SDK_PATH}/../openocd/tcl"],
            "svdFile": "${env:PICO_SDK_PATH}/src/rp2040/hardware_regs/rp2040.svd",
            "runToEntryPoint": "main",
            "openOCDLaunchCommands": ["adapter speed 5000"]
        },
        {
            "name": "Python: Current File with Variables",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/PC_Side_Code/main_var.py",
            "console": "integratedTerminal",
            "env": {
                "ENVIRONMENT": "development",
                "DEBUG_MODE": "True"
            },
            "args": [
                "--Port='/dev/ttyACM0'"
            ]
        }
    ]
}